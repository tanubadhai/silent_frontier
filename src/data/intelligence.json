{
  "subjects": [
    {
      "id": "geology",
      "title": "Planetary geology",
      "blurb": "What surfaces are made of, how they formed and what shaped them, including the history of water."
    },
    {
      "id": "atmospheres",
      "title": "Atmospheres and exospheres",
      "blurb": "The gases around a world, from thick atmospheres to almost nothing."
    },
    {
      "id": "interiors",
      "title": "Planetary interiors",
      "blurb": "What lies beneath the surface: layers, cores and the heat that escapes."
    },
    {
      "id": "plasma",
      "title": "Magnetospheres and plasma",
      "blurb": "Magnetic fields, charged particles and radiation, around planets and at the edge of the Sun’s influence."
    },
    {
      "id": "astrobiology",
      "title": "Astrobiology: habitability and organics",
      "blurb": "Water chemistry and organic material that bear on whether a place could have been habitable. No mission in this archive found life.",
      "caution": "These findings concern conditions and chemistry. None is evidence of life."
    },
    {
      "id": "engineering",
      "title": "Space exploration engineering",
      "blurb": "What the missions proved about how to build, land, power and operate spacecraft."
    }
  ],
  "instrumentCategories": [
    {
      "id": "imaging",
      "title": "Imaging",
      "blurb": "Cameras record light to show shape, texture and change. They show what a place looks like, not by themselves what it is made of."
    },
    {
      "id": "composition",
      "title": "Composition and temperature",
      "blurb": "Spectrometers and radiometers split light or radiation into its parts, which act as fingerprints for elements, minerals and temperature."
    },
    {
      "id": "interior",
      "title": "Interiors and structure",
      "blurb": "Seismometers, heat probes and radio tracking infer what lies below the surface from waves, heat flow and tiny changes in motion."
    },
    {
      "id": "fields",
      "title": "Magnetic fields",
      "blurb": "Magnetometers measure the strength and direction of magnetic fields."
    },
    {
      "id": "plasma",
      "title": "Plasma, particles and dust",
      "blurb": "These instruments count and sort charged particles, waves in plasma and impacting dust."
    },
    {
      "id": "surface",
      "title": "Surface and soil contact",
      "blurb": "Tools that touch the ground, dig, grind or press, and show how material behaves."
    },
    {
      "id": "atmosphere",
      "title": "Atmosphere and weather",
      "blurb": "Sensors for gas, pressure, wind and temperature near the surface."
    }
  ],
